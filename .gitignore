node_modules/
dist/

# Secrets
.env
**/credentials.local.json

# Dedicated Chrome profile handed to Playwright (contains your logged-in session)
chrome-profile/
**/chrome-profile/
# Named local browser profiles also contain authenticated session data.
chrome-profile-*/
**/chrome-profile-*/
# throwaway profiles from `record --fresh`
**/.chrome-profile-fresh/

# Demo projects under demos/ are TRACKED so an example setup (Containerfile,
# preflight.sh, storyboard.json, params.json, probe scripts) stays
# referenceable. Heavy/reproducible artifacts are still ignored by the rules
# below (recordings/, audio/, output/, logs/, timeline.json, captions.*).
# NEVER put a live key in a tracked demo file — use a placeholder or an env var
# (e.g. GATEWAY_KEY); gitleaks runs in CI.

# Internal strategy docs (launch plan, PRFAQ, session feedback)
docs/internal/

# Generated demo artifacts (heavy / reproducible) — for demos/ and examples/.
# storyboard.json is kept; everything derived from it is ignored.
**/recordings/
**/audio/
**/output/
**/logs/
**/generated/timeline.json
**/generated/timeline.prev.json
**/generated/params.json
**/generated/captions.srt
# ...but keep a tracked demo's resolved parameter defaults so the example
# documents how it is parameterized (non-secret placeholders only).
!**/generated/params.json
**/generated/captions.vtt
**/generated/captions.cues.json
**/generated/captions.manifest.json
# Per-language caption variants (aidemo <stage> --lang <code>).
**/generated/captions.*.srt
**/generated/captions.*.vtt
**/generated/captions.*.cues.json
**/.compose-tmp/
**/.compose-tmp-*/

# Generated music beds — reproducible via `aidemo music` / make-music.mjs, and
# heavy (~18MB). The generator script is tracked; the .wav it emits is not.
**/music.wav
assets/*.wav

# OS
.DS_Store

# session scratch files (never commit)
.tmp-*
